# Copy this file to .env and uncomment what you need.
# docker compose reads .env automatically. For `npm run dev` / `npm start`, export the variables in your shell instead.

# Access token for reaching the app from other devices.
#   off       no check (default for `npm run dev` and the localhost-only Docker setup)
#   (empty)   use the token in data/access-token.txt, created on first start
#   anything  use this exact value as the token
# ACCESS_TOKEN=

# Where runs, uploaded workflows, settings and job logs are stored. Default: ./data
# DATA_DIR=./data

# Port for `npm start` (Docker always listens on 3000 inside the container).
# PORT=3000

# API keys, as an alternative to signing in with a Claude or ChatGPT subscription.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Folder holding pi's models.json, if not ~/.pi/agent.
# PI_CODING_AGENT_DIR=
