{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workflow-runner:schema:workflow-template:1",
  "title": "Workflow Runner workflow (workflow-template, formatVersion 1)",
  "description": "A sequence of AI sessions and human review steps. See docs/workflow-format.md. Structural checks only: the app additionally checks that step ids are unique and that every step reference points at an earlier step.",
  "type": "object",
  "required": ["format", "id", "title", "steps"],
  "properties": {
    "format": { "const": "workflow-template" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "description": "Stable identifier; appears in run tags." },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "description": "Defaults to \"1\"." },
    "description": { "type": "string" },
    "intro": { "type": "array", "items": { "type": "string" } },
    "titleVariable": { "type": "string", "description": "Variable key used to suggest the run title." },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^\\w+$", "description": "Placeholder name: letters, digits and underscore." },
    "stepRef": { "type": "string", "minLength": 1, "description": "An earlier step's id or its output.file." },
    "variable": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/key", "not": { "enum": ["round", "prevRound", "priorRound", "followUp"] } },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "multiline": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "description": "Output file name, e.g. 01_research.md." },
        "title": { "type": "string" }
      }
    },
    "signal": {
      "type": "object",
      "required": ["key", "label", "options"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "match": { "type": "string", "description": "Case-insensitive regular expression for the words before the verdict on its line." },
        "options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "warnOn": { "type": "array", "items": { "type": "string" } },
        "warning": { "type": "string" },
        "fix": {
          "type": "object",
          "required": ["step", "on"],
          "properties": {
            "step": { "$ref": "#/$defs/stepRef", "description": "The earlier AI step whose output this step checked." },
            "on": { "type": "array", "items": { "type": "string" } }
          }
        },
        "followUp": { "type": "array", "items": { "type": "string" }, "description": "Values that recommend more research." }
      }
    },
    "decisionOption": {
      "type": "object",
      "required": ["value", "label", "effect"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "effect": { "enum": ["continue", "pause", "stop", "loop"] },
        "carry": { "type": "array", "items": { "type": "string" }, "description": "loop only: step ids carried into the next round." },
        "carryInto": { "type": "array", "items": { "type": "string" }, "description": "loop only: step ids that receive the carried files." }
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "type", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "enum": ["text", "questions", "decision"] },
        "label": { "type": "string" },
        "help": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "properties": {
              "placeholder": { "type": "string" },
              "questionsFrom": { "$ref": "#/$defs/stepRef" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "questions" } } },
          "then": {
            "required": ["fromStep"],
            "properties": {
              "fromStep": { "$ref": "#/$defs/stepRef" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "decision" } } },
          "then": {
            "required": ["options"],
            "properties": { "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionOption" } } }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "label", "kind", "output"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["ai", "human"] },
        "description": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/stepRef" } },
        "optionalInputs": { "type": "array", "items": { "$ref": "#/$defs/stepRef" } },
        "prompt": { "type": "string" },
        "output": { "$ref": "#/$defs/output" },
        "wordLimit": { "type": "integer", "minimum": 1 },
        "feature": { "type": "boolean" },
        "checklist": { "type": "array", "items": { "type": "string" } },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
        "outputTemplate": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "ai" } } }, "then": { "required": ["prompt"] } },
        { "if": { "properties": { "kind": { "const": "human" } } }, "then": { "required": ["fields"] } }
      ]
    }
  }
}
